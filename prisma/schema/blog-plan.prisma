// Blog Plan — BlogArticle, BlogArticleKeyword, BlogArticleStage,
//             BlogArticleFile, BlogArticleFeedback
// 1 เดือน = หลายบทความ · 1 บทความ = 5 stage (หรือ 1 stage เมื่อลูกค้าไม่ต้องตรวจงาน)

model BlogArticle {
  id       String  @id @default(uuid())
  title    String  @db.Text
  keyFocus String?
  // เดือน/ปีเป้าหมายที่บทความนี้นับเข้าโควตา (targetMonth 1-12)
  targetYear  Int
  targetMonth Int

  status     BlogArticleStatus @default(DRAFT)
  orderIndex Int               @default(0)
  // จุดตั้งต้นของ pipeline — ใช้คำนวณ dueDate ของทุก stage ใน flow
  startDate    DateTime?
  publishedUrl String?   @db.Text
  note         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("BlogArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  keywords    BlogArticleKeyword[]
  stages      BlogArticleStage[]
  files       BlogArticleFile[]
  feedbacks   BlogArticleFeedback[]
  submissions BlogArticleSubmission[]

  @@index([customerId])
  @@index([customerId, targetYear, targetMonth])
  @@map("blogarticle")
}

// เก็บเป็น "ข้อความ keyword" ไม่ใช่ FK เพราะ keyword มาได้ทั้งจาก KeywordReport,
// KeywordRecommend หรือพิมพ์เอง — sourceId ไว้ย้อนกลับไปหาแถวต้นทางเท่านั้น
model BlogArticleKeyword {
  id       String            @id @default(uuid())
  keyword  String
  source   BlogKeywordSource @default(MANUAL)
  sourceId String?

  articleId String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, keyword])
  @@index([articleId])
  @@index([keyword])
  @@map("blogarticlekeyword")
}

model BlogArticleStage {
  id          String        @id @default(uuid())
  stageCode   BlogStageCode
  seq         Int
  dueDate     DateTime?
  submittedAt DateTime?
  note        String?       @db.Text

  articleId String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, stageCode])
  @@index([articleId])
  @@map("blogarticlestage")
}

// 1 รอบการส่งงานของ writer ใน 1 stage — ลูกค้าขอแก้แล้วส่งใหม่ = เพิ่มอีก row (round +1)
// เก็บทุกรอบเพื่อให้ย้อนดูได้ว่าขอแก้อะไรแล้วแก้เป็นอะไร
model BlogArticleSubmission {
  id        String        @id @default(uuid())
  stageCode BlogStageCode
  round     Int
  message   String?       @db.Text
  linkUrl   String?       @db.Text
  createdAt DateTime      @default(now())

  articleId String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("BlogArticleSubmissionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  files BlogArticleFile[]

  @@unique([articleId, stageCode, round])
  @@index([articleId])
  @@map("blogarticlesubmission")
}

model BlogArticleFile {
  id        String       @id @default(uuid())
  kind      BlogFileKind
  url       String       @db.Text
  filename  String
  mimeType  String
  sizeBytes Int
  // นับแยกตาม kind — อัปทับไม่ลบของเดิม เพื่อดูย้อนหลังตอนลูกค้าขอแก้
  version   Int
  createdAt DateTime     @default(now())

  articleId String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // null = ไฟล์ที่อัปก่อนมีระบบส่งงานเป็นรอบ — UI แสดงเป็น "ไฟล์เดิม" ใต้ stage ที่ตรง kind
  submissionId String?
  submission   BlogArticleSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("BlogArticleFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([articleId, kind])
  @@map("blogarticlefile")
}

model BlogArticleFeedback {
  id        String               @id @default(uuid())
  stageCode BlogStageCode
  decision  BlogFeedbackDecision
  comment   String?              @db.Text
  createdAt DateTime             @default(now())

  articleId String
  article   BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("BlogArticleFeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@map("blogarticlefeedback")
}
