// Prisma base configuration — generator, datasource, enums

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum Role {
  ADMIN
  SEO_DEV
  CUSTOMER
  BLOG_WRITER
}

enum KDLevel {
  HARD
  MEDIUM
  EASY
}

enum NextStepPriority {
  HIGH
  MEDIUM
  LOW
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentPlanType {
  MONTHLY
  INSTALLMENT
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BillingCycleStatus {
  PENDING
  REVIEWING
  PAID
  OVERDUE
  CANCELLED
}

enum WorkProgressPeriodType {
  YEAR_12_MONTHS
  YEAR_4_QUARTERS
  HALF_2_PERIODS
  CUSTOM
}

enum DocumentTemplateScope {
  GENERAL
  PLAN
}

// Blog Plan — 5 stage เมื่อลูกค้าต้องตรวจงาน (Customer.blogRequiresApproval)
// ลูกค้าที่ไม่ต้องตรวจใช้แค่ SUBMIT_FINAL ขั้นเดียว
enum BlogStageCode {
  SUBMIT_TOPIC
  CLIENT_FEEDBACK_TOPIC
  SUBMIT_ARTICLE
  CLIENT_FEEDBACK_ARTICLE
  SUBMIT_FINAL
}

enum BlogArticleStatus {
  DRAFT
  IN_PROGRESS
  WAITING_CLIENT
  CHANGES_REQUESTED
  PUBLISHED
}

enum BlogFileKind {
  COVER_IMAGE
  ARTICLE_DOC
}

enum BlogFeedbackDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum BlogKeywordSource {
  REPORT
  RECOMMEND
  MANUAL
}
